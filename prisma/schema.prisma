
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES
  ACCOUNTANT
  CONSTRUCTION
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ONGOING
  ON_HOLD
  COMPLETED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  OTHER
}

enum BuildingStatus {
  PLANNING
  UNDER_CONSTRUCTION
  ON_HOLD
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum NotificationType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_STATUS_CHANGED
  EMPLOYEE_ASSIGNED
  EMPLOYEE_REMOVED
  MILESTONE_REMINDER
  MILESTONE_OVERDUE
  PROJECT_ARCHIVED
  PROJECT_RESTORED
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
}

enum FloorStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  RESERVED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  ONLINE
  OTHER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  projects  Project[]
  auditLogs AuditLog[]
  notifications Notification[]
  customers Customer[]
  bookings Booking[]
  installments Installment[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String
  role           Role         @default(VIEWER)
  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  managedProjects Project[] @relation("ProjectManager")
  createdProjects Project[] @relation("ProjectCreator")
  archivedProjects Project[] @relation("ProjectArchiver")

  createdBuildings  Building[] @relation("BuildingCreator")
  archivedBuildings Building[] @relation("BuildingArchiver")

  createdFloors  Floor[] @relation("FloorCreator")
  archivedFloors Floor[] @relation("FloorArchiver")

  createdUnits  Unit[] @relation("UnitCreator")
  archivedUnits Unit[] @relation("UnitArchiver")

  createdCustomers  Customer[] @relation("CustomerCreator")
  archivedCustomers Customer[] @relation("CustomerArchiver")

  projectMemberships ProjectMember[] @relation("ProjectMemberUser")
  assignmentsMade    ProjectMember[] @relation("ProjectMemberAssigner")

  createdMilestones ProjectMilestone[] @relation("MilestoneCreator")

  auditLogs AuditLog[] @relation("AuditActor")
  notifications Notification[] @relation("NotificationRecipient")

  createdBookings Booking[] @relation("BookingCreator")

  createdInstallments Installment[] @relation("InstallmentCreator")
  receivedPayments    Payment[]     @relation("PaymentReceiver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, role])
  @@index([organizationId, isActive])
}

model Project {
  id              String        @id @default(cuid())
  name            String
  code            String
  description     String?
  type            ProjectType   @default(RESIDENTIAL)
  status          ProjectStatus @default(PLANNING)

  address         String?
  city            String?
  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  budget          Decimal?      @db.Decimal(15, 2)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  projectManagerId String?
  projectManager   User? @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)

  archivedAt   DateTime?
  archivedById String?
  archivedBy   User? @relation("ProjectArchiver", fields: [archivedById], references: [id], onDelete: Restrict)
  archiveReason String?

  buildings  Building[]
  members    ProjectMember[]
  milestones ProjectMilestone[]
  auditLogs  AuditLog[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, type])
  @@index([organizationId, projectManagerId])
  @@index([organizationId, archivedAt])
  @@index([organizationId, startDate, expectedEndDate])
}

model Building {
  id          String         @id @default(cuid())
  name        String
  code        String
  description String?
  address     String?
  totalFloors Int?
  status      BuildingStatus @default(PLANNING)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User @relation("BuildingCreator", fields: [createdById], references: [id], onDelete: Restrict)
 
  floors Floor[]
  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User? @relation("BuildingArchiver", fields: [archivedById], references: [id], onDelete: Restrict)
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([projectId, archivedAt])
}

model Floor {
  id          String      @id @default(cuid())
  floorNumber Int
  name        String?
  description String?
  status      FloorStatus @default(ACTIVE)

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User @relation("FloorCreator", fields: [createdById], references: [id], onDelete: Restrict)

  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User? @relation("FloorArchiver", fields: [archivedById], references: [id], onDelete: Restrict)
  archiveReason String?

  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, floorNumber])
  @@index([buildingId, status])
  @@index([buildingId, archivedAt])
}

model Unit {
  id          String     @id @default(cuid())
  unitNumber  String
  name        String?
  description String?
  area        Decimal?   @db.Decimal(10, 2)
  bedrooms    Int?
  bathrooms   Int?
  price       Decimal?   @db.Decimal(15, 2)
  status      UnitStatus @default(AVAILABLE)

  floorId String
  floor   Floor @relation(fields: [floorId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User @relation("UnitCreator", fields: [createdById], references: [id], onDelete: Restrict)
  bookings Booking[]

  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User? @relation("UnitArchiver", fields: [archivedById], references: [id], onDelete: Restrict)
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([floorId, unitNumber])
  @@index([floorId, status])
  @@index([floorId, archivedAt])
}


model ProjectMember {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  userId String
  user   User @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Restrict)

  assignedById String
  assignedBy   User @relation("ProjectMemberAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  @@unique([projectId, userId])
  @@index([userId, removedAt])
  @@index([projectId, removedAt])
}

model ProjectMilestone {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime
  completedAt DateTime?

  organizationId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User @relation("MilestoneCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, dueDate])
  @@index([projectId, dueDate])
}

model AuditLog {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  actorId String?
  actor   User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  entityType String
  entityId   String
  action     String
  oldValues  Json?
  newValues  Json?
  details    String?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorId, createdAt])
  @@index([projectId, createdAt])
}

model Notification {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  recipientId String
  recipient   User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  type    NotificationType
  title   String
  message String
  data    Json?
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([recipientId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
}


model Customer {
  id          String  @id @default(cuid())
  name        String
  phone       String
  email       String?
  address     String?
  notes       String?

  organizationId String
  organization   Organization @relation( fields: [organizationId], references: [id],onDelete: Restrict)

  createdById String
  createdBy   User @relation("CustomerCreator",fields: [createdById], references: [id],onDelete: Restrict)

  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User? @relation("CustomerArchiver",fields: [archivedById],references: [id],onDelete: Restrict)
  archiveReason String?
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, archivedAt])
}


model Booking {
  id              String        @id @default(cuid())
  bookingCode     String
  status          BookingStatus @default(RESERVED)

  bookingDate     DateTime      @default(now())
  agreedPrice     Decimal       @db.Decimal(15, 2)
  bookingAmount   Decimal       @default(0) @db.Decimal(15, 2)
  notes           String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id],onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId],references: [id],onDelete: Restrict)

  unitId String
  unit   Unit @relation( fields: [unitId], references: [id],onDelete: Restrict)

  createdById String
  createdBy   User @relation("BookingCreator",fields: [createdById],references: [id], onDelete: Restrict)

  cancelledAt     DateTime?
  cancelledById   String?
  cancellationReason String?
  
  installments Installment[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, bookingCode])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
  @@index([organizationId, unitId, status])
  @@index([customerId, createdAt])
  @@index([unitId, createdAt])
}

model Installment {
  id             String            @id @default(cuid())
  installmentNo  Int
  title          String
  amount         Decimal           @db.Decimal(15, 2)
  dueDate        DateTime
  status         InstallmentStatus @default(PENDING)
  notes          String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  bookingId String
  booking   Booking @relation( fields: [bookingId],references: [id],onDelete: Restrict )

  createdById String
  createdBy   User @relation("InstallmentCreator", fields: [createdById],references: [id],onDelete: Restrict)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, installmentNo])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, bookingId])
  @@index([bookingId, dueDate])
}

model Payment {
  id            String        @id @default(cuid())
  paymentCode   String
  amount        Decimal       @db.Decimal(15, 2)
  paymentDate   DateTime      @default(now())
  method        PaymentMethod
  reference     String?
  notes         String?

  organizationId String
  organization   Organization @relation(fields: [organizationId],references: [id],onDelete: Restrict)

  bookingId String
  booking   Booking @relation( fields: [bookingId],references: [id],onDelete: Restrict)

  installmentId String
  installment   Installment @relation(fields: [installmentId],references: [id],onDelete: Restrict)

  receivedById String
  receivedBy   User @relation("PaymentReceiver",fields: [receivedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, paymentCode])
  @@index([organizationId, paymentDate])
  @@index([organizationId, bookingId])
  @@index([installmentId, paymentDate])
}